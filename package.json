{
  "name": "Soundboard",
  "version": "1.0.6",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A beautiful soundboard app with virtual mic routing for Discord",
  "devDependencies": {
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "build": {
    "appId": "com.example.soundboard",
    "productName": "Soundboard",
    "files": [
      "**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Easilestra",
      "repo": "soundboardrepo"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}